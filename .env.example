# Phase 1 (local Anvil fork) — real RPC to fork chain state from.
# Any public endpoint works for forking at the latest block (no archive access needed).
FORK_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional — pin the fork to a specific block instead of "latest" (reproducible runs)
FORK_BLOCK_NUMBER=

# Phase 2 (E2B sandbox) — required for build_template.py and e2b_run.py.
# Sign up (free, no card, Hobby tier) at https://e2b.dev, get the key from
# the dashboard.
E2B_API_KEY=

# Phase 3 (LangGraph agent) — required for sandbox_agent.py.
ANTHROPIC_API_KEY=
